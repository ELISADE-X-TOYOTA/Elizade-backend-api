# Port 5435 matches docker-compose.yml (5435->5432), chosen to avoid clashing
# with a Postgres already running on the default 5432.
DATABASE_URL=postgresql+psycopg2://elizade:elizade@localhost:5435/elizade_connect
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=divinewilson766@gmail.com
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://elizade-web.vercel.app

# Postmark. The HTTP API is used by default because most PaaS hosts block
# outbound SMTP on 587 — the symptom is a ~90s hang, not a clean error.
# POSTMARK_TOKEN falls back to SMTP_PASSWORD (Postmark uses one Server API
# Token for both). Set USE_POSTMARK_API=false to force SMTP.
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
USE_POSTMARK_API=true

# Postmark SMTP (set in .env — do not commit real credentials)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must match a verified Sender Signature on your Postmark server (not just any domain)
SMTP_FROM_EMAIL=noreply@meristemng.com
SMTP_USE_TLS=true

# ── DigitalOcean Spaces (media uploads) ──────────────────────────────────
# Unset -> uploads stay on local disk under uploads/ and serve from /media.
# Uploads are namespaced by source:
#   admin/vehicles      inventory photography (staff)
#   customer/support    ticket attachments
#   customer/warranty   claim evidence
#   customer/trade-ins  trade-in photos
#   customer/ownership  VIN claim documents
#   customer/avatars    profile photos
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=lon1
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com

# Fill the database with demo content on boot (30 vehicles, sample
# customers, tickets, appointments). Handy on a fresh local database;
# leave false anywhere real. The admin account is seeded regardless.
SEED_DEMO_DATA=false

# Tests derive their database from DATABASE_URL unless this is set. With
# DATABASE_URL pointed at a managed/remote cluster that means the suite would
# CREATE `<db>_test` on that cluster and run every schema teardown across the
# network — slow, and not something a test run should be touching. Pin it local.
TEST_DATABASE_URL=postgresql+psycopg2://elizade:elizade@localhost:5435/elizade_connect_test
